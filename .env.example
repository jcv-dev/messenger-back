SECRET_KEY=change-me-to-a-random-secret
DEBUG=False
ALLOWED_HOSTS=.your-domain.com

# Database (point at pgbouncer in production)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=domi_messager
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=0
DB_SSLMODE=prefer

# Redis (required for SSE pub/sub + throttle cache; shared across uvicorn workers)
REDIS_URL=redis://localhost:6379/0

# CORS — comma-separated list of production frontend domain(s)
CORS_ALLOWED_ORIGINS=https://your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# WhatsApp Business API
WHATSAPP_BUSINESS_ACCOUNT_ID=change-me
WHATSAPP_API_TOKEN=change-me
WHATSAPP_PHONE_NUMBER=change-me
WHATSAPP_PHONE_NUMBER_ID=change-me
WEBHOOK_TOKEN=change-me
WHATSAPP_APP_SECRET=change-me
# Optional: override the Graph API base URL (local mocks / staging proxies)
# WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com/v20.0

# Rate limit for WhatsApp outbound API (requests/second per phone number)
WA_RATE_LIMIT_THRESHOLD=70

# Retention in minutes — messages, calls, media and call recordings older than this are deleted (0 = disabled)
MESSAGE_RETENTION_MINUTES=0

# Security overrides (Dokploy Traefik handles SSL, so these default to off/auto)
SESSION_COOKIE_SECURE=
CSRF_COOKIE_SECURE=
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_SSL_REDIRECT=False

# Upload limits (bytes, default 50MB)
DATA_UPLOAD_MAX_MEMORY_SIZE=52428800
FILE_UPLOAD_MAX_MEMORY_SIZE=52428800

# Bot / Gemini
GEMINI_API_KEY=your-gemini-api-key
DOMII_CALCULATOR_URL=http://calculator:8000
DOMII_CALCULATOR_API_KEY=domii_…
BOT_MAX_CONCURRENT_TASKS=50
BOT_OPERATING_HOURS="Todos los días de 7:30 AM a 10:45 PM"
BOT_STATE_MACHINE=false    # Set to 'true' to enable state machine (interactive messages + LLM fallback)
BOT_TESTING_WARNING=false  # Set to 'true' to send testing warning message on new sessions
BOT_ESCALATE_ORDERS=false  # Set to 'true' to escalate conversation upon order submission
# Ops integration (Domiitulua public API v1) — server-to-server only
OPS_API_URL=https://api.domiitulua.com
OPS_API_KEY=dmikey_…
OPS_TIMEOUT=15
# HMAC secret for ops → Messager webhooks (same value in Domiitulua settings)
INTEGRATION_WEBHOOK_SECRET=change-me-to-a-long-random-secret
# DeepSeek (OpenAI-compatible) for the LLM order draft (Phase 6).
# V4.1 Flash is exposed by the provider as ``deepseek-flash``; the draft runs
# with thinking disabled.
ORDER_LLM_BASE_URL=https://api.deepseek.com/v1
ORDER_LLM_API_KEY=sk-…
ORDER_LLM_MODEL=deepseek-flash
ORDER_LLM_TIMEOUT=30
ORDER_LLM_DISABLE_THINKING=true
ORDER_LLM_MAX_TOOL_ROUNDS=4
# Web Push (VAPID) for browser push notifications
# Generate: openssl ecparam -genkey -name prime256v1 -out private_key.pem && openssl ec -in private_key.pem -pubout -out public_key.pem && python3 -c "import base64; print(base64.urlsafe_b64encode(open('public_key.pem','rb').read()).rstrip(b'=').decode())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=sysadmin@domiitulua.com

# Logging (DEBUG, INFO, WARNING, ERROR, CRITICAL — logs are JSON-formatted for Dozzle)
LOG_LEVEL=WARNING
