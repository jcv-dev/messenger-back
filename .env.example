SECRET_KEY=change-me-to-a-random-secret
DEBUG=False
ALLOWED_HOSTS=.your-domain.com

# Database (point at pgbouncer in production)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=domi_messager
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=0
DB_SSLMODE=prefer

# Redis (required for SSE pub/sub + throttle cache; shared across uvicorn workers)
REDIS_URL=redis://localhost:6379/0

# CORS — comma-separated list of production frontend domain(s)
CORS_ALLOWED_ORIGINS=https://your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# WhatsApp Business API
WHATSAPP_BUSINESS_ACCOUNT_ID=change-me
WHATSAPP_API_TOKEN=change-me
WHATSAPP_PHONE_NUMBER=change-me
WHATSAPP_PHONE_NUMBER_ID=change-me
WEBHOOK_TOKEN=change-me
WHATSAPP_APP_SECRET=change-me

# Message retention in minutes — messages and media older than this are deleted (0 = disabled)
MESSAGE_RETENTION_MINUTES=0

# Security overrides (Dokploy Traefik handles SSL, so these default to off/auto)
SESSION_COOKIE_SECURE=
CSRF_COOKIE_SECURE=
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_SSL_REDIRECT=False

# Upload limits (bytes, default 50MB)
DATA_UPLOAD_MAX_MEMORY_SIZE=52428800
FILE_UPLOAD_MAX_MEMORY_SIZE=52428800

# Logging (DEBUG, INFO, WARNING, ERROR, CRITICAL — logs are JSON-formatted for Dozzle)
LOG_LEVEL=WARNING
